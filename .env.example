NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@db:5432/automation?schema=public
JWT_SECRET=replace-with-a-long-random-secret

# --- WooCommerce -------------------------------------------------------
# Store base URL, e.g. https://tuTienda.com
WOOCOMMERCE_STORE_URL=
# Settings > Advanced > REST API > Add key (permissions: Read/Write)
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Settings > Advanced > Webhooks > create a webhook for "Order created" and
# "Order updated" pointing at POST /webhooks/woocommerce/orders. The secret
# configured there must match this value exactly.
WOOCOMMERCE_WEBHOOK_SECRET=

# --- Shipping ------------------------------------------------------------
# mock | dhl
SHIPPING_PROVIDER=mock

# DHL API access. Endpoint paths are deliberately left blank; fill them in
# from the documentation for the specific DHL API product in your contract
# (DHL Express MyDHL API, DHL Parcel ES, DHL eCommerce, etc). Do not guess
# production endpoints — see src/modules/dhl/dhl.provider.ts.
DHL_API_URL=
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_CREATE_SHIPMENT_PATH=
DHL_PICKUP_PATH=
DHL_TRACKING_PATH=
# Set to true only once you have confirmed your DHL contract supports/requires
# requesting pickups through the API.
DHL_PICKUP_ENABLED=false
# Fallback transit estimate (days) used only when DHL doesn't return one.
DHL_DEFAULT_TRANSIT_DAYS=2

# --- Company / default sender ("remitente") ------------------------------
# Used whenever an order does not carry its own dynamic sender data.
COMPANY_NAME=Solid Creaciones
COMPANY_EMAIL=info@solidcreaciones.es
COMPANY_PHONE=
COMPANY_CIF=E98438799
COMPANY_ADDRESS_LINE1=Camí del Mas de Moret, 29
COMPANY_CITY=Alaquàs
COMPANY_POSTAL_CODE=46970
COMPANY_PROVINCE=València
COMPANY_COUNTRY=ES

# --- Facturación (página /facturas) ----------------------------------
# Nombre fiscal con el que se emiten las facturas (puede diferir del
# COMPANY_NAME que se usa en las etiquetas de envío).
INVOICE_ISSUER_NAME=Innova Superficies Sólidas C.B.
INVOICE_ISSUER_ADDRESS_EXTRA=POL. IND. LA GARROFERA
INVOICE_DEFAULT_VAT_RATE=21
INVOICE_PAYMENT_METHOD=TRANSFERENCIA A LA VISTA
# Datos bancarios que se imprimen en la factura. Rellénalos aquí, en tu .env:
# no los subas al repositorio. Si los dejas vacíos, la factura no muestra
# el bloque del banco y se pueden escribir a mano en la propia página.
INVOICE_BANK_NAME=
INVOICE_BANK_IBAN=

# --- Factory notification -------------------------------------------
# email | webhook. WhatsApp has no official API access yet, so no WhatsApp
# automation is implemented (see src/modules/notifications/factory-notifier.ts).
FACTORY_NOTIFIER=email
FACTORY_NOTIFICATION_EMAIL=info@solidcreaciones.es
# Only used when FACTORY_NOTIFIER=webhook (e.g. Make/n8n bridge that can
# later forward to the WhatsApp Business Platform).
FACTORY_NOTIFICATION_WEBHOOK_URL=

# --- Review requests -----------------------------------------------
# email | webhook
REVIEW_NOTIFIER=email
REVIEW_NOTIFICATION_WEBHOOK_URL=
REVIEW_LINK=https://g.page/r/CUH9TQjJyAHCEBM/review
# Days added AFTER the shipment's estimated delivery date.
REVIEW_DELAY_DAYS=2
JOB_INTERVAL_MS=60000

# --- Outbound email (SMTP) ------------------------------------------
# Required when FACTORY_NOTIFIER=email and/or REVIEW_NOTIFIER=email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Solid Creaciones <info@solidcreaciones.es>
